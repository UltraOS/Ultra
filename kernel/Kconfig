choice
    prompt "Target CPU architecture"
    default ARCH_X86_64

    config ARCH_X86_64
        bool "x86_64"
        select ARCH_X86_64_BASE

    config ARCH_AARCH64
        bool "aarch64"
        select ARCH_AARCH64_BASE
endchoice

menu "Kernel build options"

choice
    prompt "Toolchain to use"
    default TOOLCHAIN_CLANG

    config TOOLCHAIN_CLANG
        bool "clang"

    config TOOLCHAIN_GCC
        bool "GCC"
endchoice

config TOOLCHAIN_STRING
    string
    default "clang" if TOOLCHAIN_CLANG
    default "gcc" if TOOLCHAIN_GCC

config OPTIMIZATION_LEVEL
    int "Optimization level to build the kernel with"
    default 0
    range 0 3

config LTO
    bool "Enable Link-Time Optimization"
    default n

endmenu

config CPU_MASK_OUT_OF_LINE
    bool
    help
        Store the contents of a cpu_mask_handle on the heap instead
        of inline within the handle itself. Out-of-line masks are
        sized by the number of CPUs detected at boot rather than the
        compile-time maximum, and every mask operation is bounded by
        that count. Intended to be selected by configurations with a
        MAX_CPUS large enough that inline masks are too big to live
        on the stack.

menu "Debug options"

config VERBOSE_INIT_LEVELS
    bool "Trace all kernel initialization level transitions"

config DEBUG_MM
    bool "Enable debug assertions for the memory management subsystem"

endmenu

rsource "arch/Kconfig"
rsource "drivers/Kconfig"
