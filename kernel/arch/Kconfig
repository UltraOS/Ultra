# Arch endianess settings
config ARCH_LITTLE_ENDIAN
    bool

config ARCH_BIG_ENDIAN
    bool

# Arch bitness settings
config ARCH_64BIT
    bool

config ARCH_32BIT
    bool

config ARCH_WIDTH
    int
    default 8 if ARCH_64BIT
    default 4 if ARCH_32BIT

config ARCH_FORCE_64BIT_PHYS_ADDR_WIDTH
    def_bool n

config ARCH_PHYS_ADDR_WIDTH
    int
    default 8 if (ARCH_64BIT || ARCH_FORCE_64BIT_PHYS_ADDR_WIDTH)
    default 4 if ARCH_32BIT

config ARCH_HAS_UBSAN
    bool

config ARCH_HAS_PAGE_SIZE_4K
    bool

choice
    prompt "Page size"

    config PAGE_SIZE_4K
        bool "4KiB"
        depends on ARCH_HAS_PAGE_SIZE_4K
endchoice

config PAGE_SHIFT
    int
    default 12 if PAGE_SIZE_4K

# Declared here so the symbol always exists as an int. An arch with
# a different cache line size gives it a default of its own.
config ARCH_CACHE_LINE_SHIFT
    int

config CACHE_LINE_SHIFT
    int
    default ARCH_CACHE_LINE_SHIFT if ARCH_CACHE_LINE_SHIFT > 0
    default 6

if ARCH_X86_64
rsource "x86_64/Kconfig"
endif

if ARCH_AARCH64
rsource "aarch64/Kconfig"
endif
